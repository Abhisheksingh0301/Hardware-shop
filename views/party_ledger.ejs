<%- include('_header') %>

<div class="mb-4 flex flex-wrap items-center justify-between gap-3">
  <div>
    <h1><%= row.name %></h1>
    <div class="text-gray-500"><%= p.label %><% if (row.phone) { %> · <%= row.phone %><% } %><% if (row.gstin) { %> · GSTIN <%= row.gstin %><% } %></div>
  </div>
  <div class="flex flex-wrap gap-2 print:hidden">
    <% if (kind === 'customers') { %>
      <a class="btn btn-primary" href="/invoices/new?customer=<%= row.id %>">+ Sale</a>
      <a class="btn" href="/grill/new?customer=<%= row.id %>">+ Grill Order</a>
    <% } else { %>
      <a class="btn btn-primary" href="/purchases/new?supplier=<%= row.id %>">+ Purchase</a>
    <% } %>
    <a class="btn" href="/<%= kind %>/<%= row.id %>/edit">Edit</a>
    <button class="btn" onclick="window.print()">Print</button>
  </div>
</div>

<div class="grid grid-cols-[repeat(auto-fit,minmax(340px,1fr))] gap-4 ">
  <div class="card">
    <h2>Details</h2>
    <table class="[&_td]:border-0 [&_td]:py-0.75 [&_td]:pr-2 [&_td]:pl-0">
      <% if (row.contact_person) { %><tr><td class="text-gray-500">Contact person</td><td><%= row.contact_person %></td></tr><% } %>
      <tr><td class="text-gray-500">Address</td><td><%= row.address || '-' %></td></tr>
      <% if (kind === 'suppliers') { %>
        <tr><td class="text-gray-500">Supplies</td><td><%= row.products_supplied || '-' %></td></tr>
        <tr><td class="text-gray-500">Credit period</td><td><%= row.credit_days %> days</td></tr>
      <% } %>
      <tr><td class="text-gray-500">Outstanding</td><td><strong class="<%= row.due > 0.009 ? 'text-red-700' : 'text-green-700' %>"><%= money(row.due) %></strong>
        <span class="text-gray-500"><%= kind === 'customers' ? '(customer owes us)' : '(we owe supplier)' %></span></td></tr>
    </table>
  </div>

  <form class="card print:hidden" method="post" action="/accounts/payments">
    <h2><%= kind === 'customers' ? 'Receive payment' : 'Pay supplier' %> (on account)</h2>
    <input type="hidden" name="direction" value="<%= kind === 'customers' ? 'in' : 'out' %>">
    <input type="hidden" name="<%= kind === 'customers' ? 'customer_id' : 'supplier_id' %>" value="<%= row.id %>">
    <input type="hidden" name="back" value="/<%= kind %>/<%= row.id %>">
    <div class="grid grid-cols-[repeat(auto-fit,minmax(200px,1fr))] gap-x-4 gap-y-3">
      <div><label>Amount (₹)</label><input type="number" step="0.01" min="0.01" name="amount" required></div>
      <div><label>Mode</label><select name="mode"><% ['Cash', 'UPI', 'Bank', 'Cheque'].forEach(function (m) { %><option><%= m %></option><% }) %></select></div>
      <div><label>Date</label><input type="date" name="pay_date" value="<%= today() %>"></div>
      <div><label>Reference / UTR / cheque no.</label><input name="reference"></div>
    </div>
    <p><button class="btn btn-primary">Save payment</button></p>
  </form>
</div>

<div class="card">
  <h2><%= p.label %> Ledger</h2>
  <div class="overflow-x-auto"><table>
    <tr><th>Date</th><th>Particulars</th><th class="text-right whitespace-nowrap"><%= kind === 'customers' ? 'Billed' : 'Purchased' %></th><th class="text-right whitespace-nowrap">Paid</th><th class="text-right whitespace-nowrap">Balance</th></tr>
    <tr><td></td><td class="text-gray-500">Opening balance</td><td></td><td></td><td class="text-right whitespace-nowrap"><%= money(row.opening_balance) %></td></tr>
    <% entries.forEach(function (e) { %>
      <tr>
        <td class="whitespace-nowrap"><%= e.date %></td>
        <td><% if (e.link) { %><a href="<%= e.link %>"><%= e.text %></a><% } else { %><%= e.text %><% } %></td>
        <td class="text-right whitespace-nowrap"><%= e.plus ? money(e.plus) : '' %></td>
        <td class="text-right whitespace-nowrap"><%= e.minus ? money(e.minus) : '' %></td>
        <td class="text-right whitespace-nowrap"><%= money(e.balance) %></td>
      </tr>
    <% }) %>
  </table></div>
</div>

<form class="print:hidden" method="post" action="/<%= kind %>/<%= row.id %>/delete" data-confirm="Delete this <%= p.label.toLowerCase() %>?">
  <button class="btn btn-danger btn-sm">Delete <%= p.label.toLowerCase() %></button>
</form>

<%- include('_footer') %>
