<%- include('_header') %>

<div class="page-head">
  <div>
    <h1><%= row.name %></h1>
    <div class="muted"><%= p.label %><% if (row.phone) { %> · <%= row.phone %><% } %><% if (row.gstin) { %> · GSTIN <%= row.gstin %><% } %></div>
  </div>
  <div class="actions no-print">
    <% if (kind === 'customers') { %>
      <a class="btn primary" href="/invoices/new?customer=<%= row.id %>">+ Sale</a>
      <a class="btn" href="/grill/new?customer=<%= row.id %>">+ Grill Order</a>
    <% } else { %>
      <a class="btn primary" href="/purchases/new?supplier=<%= row.id %>">+ Purchase</a>
    <% } %>
    <a class="btn" href="/<%= kind %>/<%= row.id %>/edit">Edit</a>
    <button class="btn" onclick="window.print()">Print</button>
  </div>
</div>

<div class="grid two">
  <div class="card">
    <h2>Details</h2>
    <table class="plain">
      <% if (row.contact_person) { %><tr><td class="muted">Contact person</td><td><%= row.contact_person %></td></tr><% } %>
      <tr><td class="muted">Address</td><td><%= row.address || '-' %></td></tr>
      <% if (kind === 'suppliers') { %>
        <tr><td class="muted">Supplies</td><td><%= row.products_supplied || '-' %></td></tr>
        <tr><td class="muted">Credit period</td><td><%= row.credit_days %> days</td></tr>
      <% } %>
      <tr><td class="muted">Outstanding</td><td><strong class="<%= row.due > 0.009 ? 'neg' : 'pos' %>"><%= money(row.due) %></strong>
        <span class="muted"><%= kind === 'customers' ? '(customer owes us)' : '(we owe supplier)' %></span></td></tr>
    </table>
  </div>

  <form class="card no-print" method="post" action="/accounts/payments">
    <h2><%= kind === 'customers' ? 'Receive payment' : 'Pay supplier' %> (on account)</h2>
    <input type="hidden" name="direction" value="<%= kind === 'customers' ? 'in' : 'out' %>">
    <input type="hidden" name="<%= kind === 'customers' ? 'customer_id' : 'supplier_id' %>" value="<%= row.id %>">
    <input type="hidden" name="back" value="/<%= kind %>/<%= row.id %>">
    <div class="form-grid">
      <div><label>Amount (₹)</label><input type="number" step="0.01" min="0.01" name="amount" required></div>
      <div><label>Mode</label><select name="mode"><% ['Cash', 'UPI', 'Bank', 'Cheque'].forEach(function (m) { %><option><%= m %></option><% }) %></select></div>
      <div><label>Date</label><input type="date" name="pay_date" value="<%= today() %>"></div>
      <div><label>Reference / UTR / cheque no.</label><input name="reference"></div>
    </div>
    <p><button class="btn primary">Save payment</button></p>
  </form>
</div>

<div class="card">
  <h2><%= p.label %> Ledger</h2>
  <div class="table-wrap"><table>
    <tr><th>Date</th><th>Particulars</th><th class="num"><%= kind === 'customers' ? 'Billed' : 'Purchased' %></th><th class="num">Paid</th><th class="num">Balance</th></tr>
    <tr><td></td><td class="muted">Opening balance</td><td></td><td></td><td class="num"><%= money(row.opening_balance) %></td></tr>
    <% entries.forEach(function (e) { %>
      <tr>
        <td class="nowrap"><%= e.date %></td>
        <td><% if (e.link) { %><a href="<%= e.link %>"><%= e.text %></a><% } else { %><%= e.text %><% } %></td>
        <td class="num"><%= e.plus ? money(e.plus) : '' %></td>
        <td class="num"><%= e.minus ? money(e.minus) : '' %></td>
        <td class="num"><%= money(e.balance) %></td>
      </tr>
    <% }) %>
  </table></div>
</div>

<form class="no-print" method="post" action="/<%= kind %>/<%= row.id %>/delete" data-confirm="Delete this <%= p.label.toLowerCase() %>?">
  <button class="btn danger small">Delete <%= p.label.toLowerCase() %></button>
</form>

<%- include('_footer') %>
