<%- include('_header') %>

<%
  var balance = job.agreed_price - job.paid;
  var isQuote = print === 'quote';
  var stepIndex = GRILL_STATUSES.indexOf(job.status);
%>

<div class="mb-4 flex flex-wrap items-center justify-between gap-3 print:hidden">
  <div>
    <h1>Job <%= job.job_no %></h1>
    <span class="badge <%= job.status === 'Completed' ? 'badge-good' : job.status === 'Cancelled' ? 'badge-danger' : 'badge-warn' %>"><%= job.status %></span>
  </div>
  <div class="flex flex-wrap gap-2">
    <button class="btn btn-primary" onclick="window.print()">Print <%= isQuote ? 'quotation' : 'job card' %></button>
    <% if (isQuote) { %><a class="btn" href="/grill/<%= job.id %>">Job card view</a><% } else { %><a class="btn" href="/grill/<%= job.id %>?print=quote">Quotation view</a><% } %>
    <a class="btn" href="/grill/<%= job.id %>/edit">Edit order</a>
  </div>
</div>

<!-- ================= printable job card / quotation ================= -->
<div class="card max-w-[820px]">
  <div class="mb-3 flex justify-between gap-4 border-b-2 border-gray-800 pb-2.5 [&_h1]:text-xl">
    <%- include('_shop') %>
    <div class="text-right">
      <h1><%= isQuote ? 'QUOTATION' : 'JOB CARD' %></h1>
      <div>Job no. <strong><%= job.job_no %></strong></div>
      <div>Date: <%= job.created_at.slice(0, 10) %></div>
    </div>
  </div>

  <div class="grid grid-cols-[repeat(auto-fit,minmax(340px,1fr))] gap-4 ">
    <table class="[&_td]:border-0 [&_td]:py-0.75 [&_td]:pr-2 [&_td]:pl-0">
      <tr><td class="text-gray-500">Customer</td><td><a href="/customers/<%= job.customer_id %>"><strong><%= job.customer %></strong></a></td></tr>
      <tr><td class="text-gray-500">Phone</td><td><%= job.phone || '-' %></td></tr>
      <tr><td class="text-gray-500">Site</td><td><%= job.site_address || job.address || '-' %></td></tr>
      <tr><td class="text-gray-500">Delivery</td><td><%= job.delivery_required ? 'Yes' : 'No' %><%= job.expected_date ? ' · by ' + job.expected_date : '' %></td></tr>
      <tr><td class="text-gray-500">Installation</td><td><%= job.installation_required ? 'Yes' : 'No' %></td></tr>
    </table>
    <table class="[&_td]:border-0 [&_td]:py-0.75 [&_td]:pr-2 [&_td]:pl-0">
      <tr><td class="text-gray-500">Product</td><td><strong><%= job.grill_type || 'Grill' %></strong> × <%= job.quantity %></td></tr>
      <tr><td class="text-gray-500">Width × Height</td><td><%= job.width || '___' %> × <%= job.height || '___' %></td></tr>
      <tr><td class="text-gray-500">Frame</td><td><%= job.frame_size || '-' %></td></tr>
      <tr><td class="text-gray-500">Rod size / spacing</td><td><%= job.rod_size || '-' %> / <%= job.spacing || '-' %></td></tr>
      <tr><td class="text-gray-500">Material</td><td><%= job.material_spec || '-' %></td></tr>
      <tr><td class="text-gray-500">Finish</td><td><%= job.finish || '-' %></td></tr>
    </table>
  </div>
  <% if (job.other_measurements) { %><p><strong>Other measurements:</strong> <%= job.other_measurements %></p><% } %>
  <% if (job.design) { %><p><strong>Design:</strong> <%= job.design %></p><% } %>
  <% if (job.notes) { %><p><strong>Notes:</strong> <%= job.notes %></p><% } %>

  <table class="ml-auto max-w-[340px] [&_td]:border-0 [&_td]:px-2 [&_td]:py-0.75">
    <tr class="text-[17px] font-bold *:border-t!"><td>Agreed price</td><td class="text-right whitespace-nowrap"><%= money(job.agreed_price) %></td></tr>
    <tr><td>Received</td><td class="text-right whitespace-nowrap"><%= money(job.paid) %></td></tr>
    <tr><td><strong>Balance</strong></td><td class="text-right whitespace-nowrap <%= balance > 0.009 ? 'text-red-700' : '' %>"><strong><%= money(balance) %></strong></td></tr>
  </table>

  <% if (isQuote) { %>
    <p class="mt-6 text-gray-500">Price includes material, fabrication<%= job.finish ? ', painting' : '' %><%= job.installation_required ? ' and installation' : '' %>.
      Advance payment required to start work. Balance payable on delivery.</p>
    <% if (shop.upiId) { %><p>UPI: <strong><%= shop.upiId %></strong><%= shop.upiName ? ' (' + shop.upiName + ')' : '' %></p><% } %>
    <% if (shop.bankAccount) { %><p>Bank: <%= shop.bankName %> · A/c <%= shop.bankAccount %> · IFSC <%= shop.bankIfsc %></p><% } %>
    <p class="mt-10 text-right">Authorised signature</p>
  <% } else { %>
    <h3>Estimated material</h3>
    <% if (!materials.length) { %>
      <table class="[&_td]:border-0 [&_td]:py-0.75 [&_td]:pr-2 [&_td]:pl-0">
        <% ['MS Rod', 'MS Flat', 'MS Angle', 'Welding Electrode', 'Paint / Primer'].forEach(function (m) { %>
          <tr><td><%= m %></td><td><span class="inline-block min-w-30 border-b border-dotted border-gray-400"></span></td></tr>
        <% }) %>
      </table>
    <% } else { %>
      <table>
        <tr><th>Material</th><th class="text-right whitespace-nowrap">Estimated</th><th class="text-right whitespace-nowrap">Issued</th><th class="text-right whitespace-nowrap print:hidden">In stock</th></tr>
        <% materials.forEach(function (m) { %>
          <tr>
            <td><%= m.name %></td>
            <td class="text-right whitespace-nowrap"><%= qty(m.est_qty) %> <%= m.unit %></td>
            <td class="text-right whitespace-nowrap"><%= qty(m.issued_qty) %> <%= m.unit %></td>
            <td class="text-right whitespace-nowrap print:hidden <%= m.stock < m.est_qty - m.issued_qty ? 'text-red-700' : '' %>"><%= qty(m.stock) %></td>
          </tr>
        <% }) %>
      </table>
    <% } %>

    <h3>Status</h3>
    <div>
      <% GRILL_STATUSES.forEach(function (s, i) { if (s === 'Cancelled') return; %>
        <span class="mr-3 whitespace-nowrap"><%= i <= stepIndex && job.status !== 'Cancelled' ? '☑' : '☐' %> <%= s %></span>
      <% }) %>
    </div>
  <% } %>
</div>

<% if (!isQuote) { %>
<!-- ================= production (not printed) ================= -->
<div class="grid grid-cols-[repeat(auto-fit,minmax(340px,1fr))] gap-4 print:hidden">
  <form class="card" method="post" action="/grill/<%= job.id %>/status">
    <h2>Production status</h2>
    <div class="grid grid-cols-[repeat(auto-fit,minmax(200px,1fr))] gap-x-4 gap-y-3">
      <div>
        <label>New status</label>
        <select name="status">
          <% GRILL_STATUSES.forEach(function (s, i) { %>
            <option <%= i === stepIndex + 1 ? 'selected' : '' %>><%= s %></option>
          <% }) %>
        </select>
      </div>
      <div><label>Note</label><input name="note" placeholder="optional"></div>
    </div>
    <p><button class="btn btn-primary">Update status</button></p>
    <ul>
      <% log.forEach(function (l) { %>
        <li class="relative border-l-2 border-gray-200 py-1.25 pl-4 before:absolute before:top-2.75 before:-left-1.5 before:size-2.5 before:rounded-full before:bg-orange-700"><strong><%= l.status %></strong> <small class="text-gray-500"><%= l.created_at %></small><% if (l.note) { %><br><small><%= l.note %></small><% } %></li>
      <% }) %>
    </ul>
  </form>

  <div class="card">
    <h2>Payments (advance / balance)</h2>
    <% if (!payments.length) { %><p class="text-gray-500">No payment received yet.</p><% } else { %>
    <table>
      <tr><th>Date</th><th>Mode</th><th>Ref</th><th class="text-right whitespace-nowrap">Amount</th><th></th></tr>
      <% payments.forEach(function (p) { %>
        <tr>
          <td><%= p.pay_date %></td><td><%= p.mode %></td><td><%= p.reference %></td>
          <td class="text-right whitespace-nowrap"><%= money(p.amount) %></td>
          <td class="whitespace-nowrap">
            <a class="btn btn-sm" href="/accounts/payments/<%= p.id %>">Receipt</a>
            <form class="inline" method="post" action="/accounts/payments/<%= p.id %>/delete" data-confirm="Delete this payment?">
              <input type="hidden" name="back" value="/grill/<%= job.id %>"><button class="btn btn-sm btn-danger">✕</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </table>
    <% } %>
    <% if (balance > 0.009) { %>
      <form class="mt-3" method="post" action="/accounts/payments">
        <input type="hidden" name="job_id" value="<%= job.id %>">
        <input type="hidden" name="back" value="/grill/<%= job.id %>">
        <div class="grid grid-cols-[repeat(auto-fit,minmax(200px,1fr))] gap-x-4 gap-y-3">
          <div><label>Amount</label><input type="number" step="0.01" min="0.01" name="amount" value="<%= balance.toFixed(2) %>"></div>
          <div><label>Mode</label><select name="mode"><% PAY_MODES.forEach(function (m) { %><option><%= m %></option><% }) %></select></div>
          <div><label>Date</label><input type="date" name="pay_date" value="<%= today() %>"></div>
          <div><label>Reference</label><input name="reference"></div>
        </div>
        <p><button class="btn btn-primary">Receive payment</button></p>
      </form>
    <% } %>
  </div>
</div>

<div class="grid grid-cols-[repeat(auto-fit,minmax(340px,1fr))] gap-4 print:hidden">
  <form class="card lines-box" method="post" action="/grill/<%= job.id %>/materials" data-mode="material"
        data-items="<%= JSON.stringify(materials.map(function (m) { return { product_id: m.product_id, qty: m.est_qty }; })) %>">
    <h2>Material planning (estimate)</h2>
    <% if (!rawProducts.length) { %>
      <p class="text-gray-500">No raw materials yet. <a href="/inventory/new?type=raw">Add raw material</a> (MS rods, flats, angles, electrodes...).</p>
    <% } %>
    <table class="[&_input]:px-1.5 [&_input]:py-1 [&_select]:px-1.5 [&_select]:py-1 [&_td]:p-1">
      <thead><tr><th>Raw material</th><th class="w-[90px]">Est. qty</th><th></th></tr></thead>
      <tbody></tbody>
    </table>
    <template>
      <tr>
        <td>
          <select name="product_id">
            <option value="">-- select material --</option>
            <% rawProducts.forEach(function (p) { %>
              <option value="<%= p.id %>" data-unit="<%= p.unit %>" data-stock="<%= p.stock %>"><%= p.name %><%= p.size ? ' · ' + p.size : '' %></option>
            <% }) %>
          </select>
          <small class="info text-gray-500"></small>
        </td>
        <td><input class="w-[90px]" type="number" step="any" min="0" name="qty"></td>
        <td><button type="button" class="btn btn-sm remove">✕</button></td>
      </tr>
    </template>
    <p><button class="btn btn-primary">Save estimate</button></p>
  </form>

  <form class="card" method="post" action="/grill/<%= job.id %>/issue">
    <h2>Issue material from stock</h2>
    <% if (!materials.length) { %>
      <p class="text-gray-500">Save a material estimate first.</p>
    <% } else { %>
      <p class="text-gray-500">Issuing reduces manufacturing stock. Enter a negative quantity to return unused material.</p>
      <div class="grid grid-cols-[repeat(auto-fit,minmax(200px,1fr))] gap-x-4 gap-y-3">
        <div>
          <label>Material</label>
          <select name="product_id">
            <% materials.forEach(function (m) { var left = m.est_qty - m.issued_qty; %>
              <option value="<%= m.product_id %>"><%= m.name %> (to issue: <%= qty(left > 0 ? left : 0) %> <%= m.unit %>, stock <%= qty(m.stock) %>)</option>
            <% }) %>
          </select>
        </div>
        <div><label>Quantity</label><input type="number" step="any" name="qty" required></div>
      </div>
      <p><button class="btn btn-primary">Issue</button></p>
    <% } %>
  </form>
</div>

<form class="print:hidden" method="post" action="/grill/<%= job.id %>/delete" data-confirm="Delete this grill job permanently?">
  <button class="btn btn-danger btn-sm">Delete job</button>
</form>
<% } %>

<%- include('_footer') %>
