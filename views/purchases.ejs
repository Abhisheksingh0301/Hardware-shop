<%- include('_header') %>

<div class="page-head">
  <h1>Purchases</h1>
  <a class="btn primary" href="/purchases/new">+ New Purchase</a>
</div>

<div class="card">
  <form class="filters" method="get">
    <div><label>From</label><input type="date" name="from" value="<%= from %>"></div>
    <div><label>To</label><input type="date" name="to" value="<%= to %>"></div>
    <div><label>Search</label><input name="q" value="<%= q %>" placeholder="Bill no. or supplier"></div>
    <button class="btn">Show</button>
  </form>

  <% if (!rows.length) { %><p class="muted">No purchases in this period.</p><% } else {
       var sum = { total: 0, paid: 0 }; %>
  <div class="table-wrap"><table>
    <tr><th>Date</th><th>Supplier</th><th>Bill no.</th><th class="num">GST</th><th class="num">Total</th><th class="num">Paid</th><th class="num">Balance</th><th></th></tr>
    <% rows.forEach(function (r) { var bal = r.total - r.paid; sum.total += r.total; sum.paid += r.paid; %>
      <tr>
        <td><a href="/purchases/<%= r.id %>"><%= r.purchase_date %></a></td>
        <td><a href="/suppliers/<%= r.supplier_id %>"><%= r.supplier %></a></td>
        <td><a href="/purchases/<%= r.id %>"><%= r.invoice_no || '#' + r.id %></a></td>
        <td class="num"><%= money(r.tax) %></td>
        <td class="num"><%= money(r.total) %></td>
        <td class="num"><%= money(r.paid) %></td>
        <td class="num <%= bal > 0.009 ? 'neg' : '' %>"><%= money(bal) %></td>
        <td><span class="badge <%= bal > 0.009 ? (r.paid > 0 ? 'warn' : 'danger') : 'good' %>"><%= bal > 0.009 ? (r.paid > 0 ? 'Part paid' : 'Unpaid') : 'Paid' %></span></td>
      </tr>
    <% }) %>
    <tfoot><tr><td colspan="4"><%= rows.length %> purchases</td><td class="num"><%= money(sum.total) %></td><td class="num"><%= money(sum.paid) %></td><td class="num"><%= money(sum.total - sum.paid) %></td><td></td></tr></tfoot>
  </table></div>
  <% } %>
</div>

<%- include('_footer') %>
