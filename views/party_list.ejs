<%- include('_header') %>

<div class="mb-4 flex flex-wrap items-center justify-between gap-3">
  <h1><%= p.plural %></h1>
  <div class="flex flex-wrap gap-2"><a class="btn btn-primary" href="/<%= kind %>/new">+ New <%= p.label %></a></div>
</div>

<div class="card">
  <form class="mb-3 flex flex-wrap items-end gap-2 *:w-auto [&_input]:min-w-[140px] [&_select]:min-w-[140px]" method="get">
    <input name="q" value="<%= q %>" placeholder="Search name or phone">
    <button class="btn">Search</button>
  </form>

  <% if (!rows.length) { %><p class="text-gray-500">No <%= p.plural.toLowerCase() %> found.</p><% } else { %>
  <div class="overflow-x-auto"><table>
    <tr>
      <th>Name</th><th>Phone</th>
      <% if (kind === 'suppliers') { %><th>Contact person</th><th>Supplies</th><th>Credit</th><% } else { %><th>Address</th><% } %>
      <th class="text-right whitespace-nowrap"><%= kind === 'customers' ? 'Receivable' : 'Payable' %></th>
    </tr>
    <% rows.forEach(function (r) { %>
      <tr>
        <td><a href="/<%= kind %>/<%= r.id %>"><%= r.name %></a></td>
        <td><%= r.phone %></td>
        <% if (kind === 'suppliers') { %>
          <td><%= r.contact_person %></td><td><%= r.products_supplied %></td><td><%= r.credit_days %> days</td>
        <% } else { %>
          <td><%= r.address %></td>
        <% } %>
        <td class="text-right whitespace-nowrap <%= r.due > 0.009 ? 'text-red-700' : '' %>"><%= money(r.due) %></td>
      </tr>
    <% }) %>
  </table></div>
  <% } %>
</div>

<%- include('_footer') %>
