<%- include('_header') %>

<div class="mb-4 flex flex-wrap items-center justify-between gap-3"><h1>Payments</h1></div>

<form class="card" method="post" action="/accounts/payments">
  <h2>Record a payment (on account)</h2>
  <p class="text-gray-500">To pay against a specific invoice, grill job or purchase, open that document instead.</p>
  <div class="grid grid-cols-[repeat(auto-fit,minmax(200px,1fr))] gap-x-4 gap-y-3">
    <div>
      <label>Type</label>
      <select name="direction" data-direction>
        <option value="in">Received from customer</option>
        <option value="out">Paid to supplier</option>
      </select>
    </div>
    <div data-show-for="in">
      <label>Customer</label>
      <select name="customer_id">
        <option value="">-- select --</option>
        <% customers.forEach(function (c) { %><option value="<%= c.id %>"><%= c.name %><%= c.due > 0.009 ? ' (owes ' + money(c.due) + ')' : '' %></option><% }) %>
      </select>
    </div>
    <div data-show-for="out" hidden>
      <label>Supplier</label>
      <select name="supplier_id">
        <option value="">-- select --</option>
        <% suppliers.forEach(function (s) { %><option value="<%= s.id %>"><%= s.name %><%= s.due > 0.009 ? ' (due ' + money(s.due) + ')' : '' %></option><% }) %>
      </select>
    </div>
    <div><label>Amount (₹)</label><input type="number" step="0.01" min="0.01" name="amount" required></div>
    <div><label>Mode</label><select name="mode"><% PAY_MODES.forEach(function (m) { %><option><%= m %></option><% }) %></select></div>
    <div><label>Date</label><input type="date" name="pay_date" value="<%= today() %>"></div>
    <div><label>Reference / UTR / cheque no.</label><input name="reference"></div>
    <div><label>Note</label><input name="note"></div>
  </div>
  <p><button class="btn btn-primary">Save payment</button></p>
</form>

<div class="card">
  <form class="mb-3 flex flex-wrap items-end gap-2 *:w-auto [&_input]:min-w-[140px] [&_select]:min-w-[140px]" method="get">
    <div><label>From</label><input type="date" name="from" value="<%= from %>"></div>
    <div><label>To</label><input type="date" name="to" value="<%= to %>"></div>
    <div>
      <label>Show</label>
      <select name="dir">
        <option value="">All</option>
        <option value="in" <%= dir === 'in' ? 'selected' : '' %>>Received</option>
        <option value="out" <%= dir === 'out' ? 'selected' : '' %>>Paid</option>
      </select>
    </div>
    <button class="btn">Show</button>
  </form>

  <% if (!rows.length) { %><p class="text-gray-500">No payments in this period.</p><% } else {
       var tin = 0, tout = 0; %>
  <div class="overflow-x-auto"><table>
    <tr><th>Date</th><th>Party</th><th>Against</th><th>Mode</th><th>Reference</th><th class="text-right whitespace-nowrap">Received</th><th class="text-right whitespace-nowrap">Paid</th><th></th></tr>
    <% rows.forEach(function (p) { if (p.direction === 'in') tin += p.amount; else tout += p.amount; %>
      <tr>
        <td class="whitespace-nowrap"><%= p.pay_date %></td>
        <td>
          <% if (p.customer_id) { %><a href="/customers/<%= p.customer_id %>"><%= p.customer %></a>
          <% } else if (p.supplier_id) { %><a href="/suppliers/<%= p.supplier_id %>"><%= p.supplier %></a>
          <% } else { %>Walk-in<% } %>
        </td>
        <td>
          <% if (p.invoice_id) { %><a href="/invoices/<%= p.invoice_id %>"><%= p.invoice_no %></a>
          <% } else if (p.job_id) { %><a href="/grill/<%= p.job_id %>"><%= p.job_no %></a>
          <% } else if (p.purchase_id) { %><a href="/purchases/<%= p.purchase_id %>">Purchase <%= p.purchase_no || '#' + p.purchase_id %></a>
          <% } else { %><span class="text-gray-500">On account</span><% } %>
        </td>
        <td><%= p.mode %></td>
        <td><%= p.reference %></td>
        <td class="text-right whitespace-nowrap text-green-700"><%= p.direction === 'in' ? money(p.amount) : '' %></td>
        <td class="text-right whitespace-nowrap text-red-700"><%= p.direction === 'out' ? money(p.amount) : '' %></td>
        <td class="whitespace-nowrap">
          <a class="btn btn-sm" href="/accounts/payments/<%= p.id %>"><%= p.direction === 'in' ? 'Receipt' : 'Voucher' %></a>
          <form class="inline" method="post" action="/accounts/payments/<%= p.id %>/delete" data-confirm="Delete this payment?">
            <button class="btn btn-sm btn-danger">✕</button>
          </form>
        </td>
      </tr>
    <% }) %>
    <tfoot><tr><td colspan="5">Total</td><td class="text-right whitespace-nowrap"><%= money(tin) %></td><td class="text-right whitespace-nowrap"><%= money(tout) %></td><td></td></tr></tfoot>
  </table></div>
  <% } %>
</div>

<%- include('_footer') %>
