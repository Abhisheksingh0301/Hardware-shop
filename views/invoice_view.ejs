<%- include('_header') %>

<% var balance = inv.total - inv.paid; %>

<div class="mb-4 flex flex-wrap items-center justify-between gap-3 print:hidden">
  <h1>Invoice <%= inv.invoice_no %></h1>
  <div class="flex flex-wrap gap-2">
    <button class="btn btn-primary" onclick="window.print()">Print</button>
    <a class="btn" href="/invoices/new">+ New Sale</a>
    <form class="inline" method="post" action="/invoices/<%= inv.id %>/delete" data-confirm="Cancel this invoice? Stock will be returned and its payments removed.">
      <button class="btn btn-danger">Cancel invoice</button>
    </form>
  </div>
</div>

<div class="card max-w-[820px]">
  <div class="mb-3 flex justify-between gap-4 border-b-2 border-gray-800 pb-2.5 [&_h1]:text-xl">
    <%- include('_shop') %>
    <div class="text-right">
      <h1>TAX INVOICE</h1>
      <div>No. <strong><%= inv.invoice_no %></strong></div>
      <div>Date: <%= inv.invoice_date %></div>
    </div>
  </div>

  <p>
    <strong>Bill to:</strong>
    <% if (inv.customer_id) { %>
      <%= inv.cust_name %><% if (inv.phone) { %> · <%= inv.phone %><% } %>
      <% if (inv.address) { %><br><%= inv.address %><% } %>
      <% if (inv.gstin) { %><br>GSTIN: <%= inv.gstin %><% } %>
    <% } else { %>
      <%= inv.customer_name || 'Walk-in customer' %>
    <% } %>
  </p>

  <div class="overflow-x-auto"><table>
    <tr><th>#</th><th>Item</th><th class="text-right whitespace-nowrap">Qty</th><th class="text-right whitespace-nowrap">Rate</th><th class="text-right whitespace-nowrap">Disc</th><th class="text-right whitespace-nowrap">GST</th><th class="text-right whitespace-nowrap">Amount</th></tr>
    <% items.forEach(function (it, i) { %>
      <tr>
        <td><%= i + 1 %></td>
        <td><%= it.name %><% if (it.brand || it.size) { %> <small class="text-gray-500"><%= [it.brand, it.size].filter(Boolean).join(' · ') %></small><% } %></td>
        <td class="text-right whitespace-nowrap"><%= qty(it.qty) %> <%= it.unit %></td>
        <td class="text-right whitespace-nowrap"><%= money(it.rate) %></td>
        <td class="text-right whitespace-nowrap"><%= it.disc_pct ? it.disc_pct + '%' : '' %></td>
        <td class="text-right whitespace-nowrap"><%= it.gst_rate %>%</td>
        <td class="text-right whitespace-nowrap"><%= money(it.amount) %></td>
      </tr>
    <% }) %>
  </table></div>

  <table class="ml-auto max-w-[340px] [&_td]:border-0 [&_td]:px-2 [&_td]:py-0.75">
    <tr><td>Subtotal</td><td class="text-right whitespace-nowrap"><%= money(inv.subtotal) %></td></tr>
    <% if (inv.discount) { %><tr><td>Discount</td><td class="text-right whitespace-nowrap">− <%= money(inv.discount) %></td></tr><% } %>
    <tr><td>GST</td><td class="text-right whitespace-nowrap"><%= money(inv.tax) %></td></tr>
    <tr class="text-[17px] font-bold *:border-t!"><td>Total</td><td class="text-right whitespace-nowrap"><%= money(inv.total) %></td></tr>
    <tr><td>Paid</td><td class="text-right whitespace-nowrap"><%= money(inv.paid) %></td></tr>
    <tr><td><strong>Balance due</strong></td><td class="text-right whitespace-nowrap <%= balance > 0.009 ? 'text-red-700' : '' %>"><strong><%= money(balance) %></strong></td></tr>
  </table>
  <% if (inv.notes) { %><p class="text-gray-500">Note: <%= inv.notes %></p><% } %>
  <% if (balance > 0.009 && (shop.upiId || shop.bankAccount)) { %>
    <div class="mt-4 flex items-center gap-4">
      <% if (qr) { %>
        <img src="<%= qr %>" alt="UPI QR code" width="130" height="130">
      <% } %>
      <div>
        <strong>Pay balance of <%= money(balance) %>:</strong>
        <% if (shop.upiId) { %><div>UPI: <strong><%= shop.upiId %></strong><%= shop.upiName ? ' (' + shop.upiName + ')' : '' %></div><% } %>
        <% if (qr) { %><div class="text-gray-500">Scan with any UPI app — amount is filled in</div><% } %>
        <% if (shop.bankAccount) { %><div>Bank: <%= shop.bankName %> · A/c <%= shop.bankAccount %> · IFSC <%= shop.bankIfsc %></div><% } %>
      </div>
    </div>
  <% } %>
  <p class="mt-7.5 text-gray-500"><%= shop.invoiceFooter %></p>
</div>

<div class="card print:hidden">
  <h2>Payments</h2>
  <% if (!payments.length) { %><p class="text-gray-500">No payment received yet.</p><% } else { %>
  <table>
    <tr><th>Date</th><th>Mode</th><th>Reference</th><th class="text-right whitespace-nowrap">Amount</th><th></th></tr>
    <% payments.forEach(function (p) { %>
      <tr>
        <td><%= p.pay_date %></td><td><%= p.mode %></td><td><%= p.reference %></td>
        <td class="text-right whitespace-nowrap"><%= money(p.amount) %></td>
        <td class="whitespace-nowrap">
          <a class="btn btn-sm" href="/accounts/payments/<%= p.id %>">Receipt</a>
          <form class="inline" method="post" action="/accounts/payments/<%= p.id %>/delete" data-confirm="Delete this payment?">
            <input type="hidden" name="back" value="/invoices/<%= inv.id %>"><button class="btn btn-sm btn-danger">Delete</button>
          </form>
        </td>
      </tr>
    <% }) %>
  </table>
  <% } %>

  <% if (balance > 0.009) { %>
    <form method="post" action="/accounts/payments" class="mt-3 flex flex-wrap items-end gap-2 *:w-auto [&_input]:min-w-[140px] [&_select]:min-w-[140px]">
      <input type="hidden" name="invoice_id" value="<%= inv.id %>">
      <input type="hidden" name="back" value="/invoices/<%= inv.id %>">
      <div><label>Amount</label><input type="number" step="0.01" min="0.01" name="amount" value="<%= balance.toFixed(2) %>"></div>
      <div><label>Mode</label><select name="mode"><% PAY_MODES.forEach(function (m) { %><option><%= m %></option><% }) %></select></div>
      <div><label>Date</label><input type="date" name="pay_date" value="<%= today() %>"></div>
      <div><label>Reference</label><input name="reference"></div>
      <button class="btn btn-primary">Receive payment</button>
    </form>
  <% } %>
</div>

<%- include('_footer') %>
