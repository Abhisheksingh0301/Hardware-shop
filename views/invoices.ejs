<%- include('_header') %>

<div class="mb-4 flex flex-wrap items-center justify-between gap-3">
  <h1>Sales Invoices</h1>
  <a class="btn btn-primary" href="/invoices/new">+ New Sale</a>
</div>

<div class="card">
  <form class="mb-3 flex flex-wrap items-end gap-2 *:w-auto [&_input]:min-w-[140px] [&_select]:min-w-[140px]" method="get">
    <div><label>From</label><input type="date" name="from" value="<%= from %>"></div>
    <div><label>To</label><input type="date" name="to" value="<%= to %>"></div>
    <div><label>Search</label><input name="q" value="<%= q %>" placeholder="Invoice no. or customer"></div>
    <button class="btn">Show</button>
  </form>

  <% if (!rows.length) { %><p class="text-gray-500">No invoices in this period.</p><% } else {
       var sum = { total: 0, paid: 0 }; %>
  <div class="overflow-x-auto"><table>
    <tr><th>Invoice</th><th>Date</th><th>Customer</th><th class="text-right whitespace-nowrap">Total</th><th class="text-right whitespace-nowrap">Paid</th><th class="text-right whitespace-nowrap">Balance</th><th></th></tr>
    <% rows.forEach(function (r) { var bal = r.total - r.paid; sum.total += r.total; sum.paid += r.paid; %>
      <tr>
        <td><a href="/invoices/<%= r.id %>"><%= r.invoice_no %></a></td>
        <td><%= r.invoice_date %></td>
        <td><% if (r.customer_id) { %><a href="/customers/<%= r.customer_id %>"><%= r.customer %></a><% } else { %><%= r.customer %><% } %></td>
        <td class="text-right whitespace-nowrap"><%= money(r.total) %></td>
        <td class="text-right whitespace-nowrap"><%= money(r.paid) %></td>
        <td class="text-right whitespace-nowrap <%= bal > 0.009 ? 'text-red-700' : '' %>"><%= money(bal) %></td>
        <td><span class="badge <%= bal > 0.009 ? (r.paid > 0 ? 'badge-warn' : 'badge-danger') : 'badge-good' %>"><%= bal > 0.009 ? (r.paid > 0 ? 'Part paid' : 'Unpaid') : 'Paid' %></span></td>
      </tr>
    <% }) %>
    <tfoot><tr><td colspan="3"><%= rows.length %> invoices</td><td class="text-right whitespace-nowrap"><%= money(sum.total) %></td><td class="text-right whitespace-nowrap"><%= money(sum.paid) %></td><td class="text-right whitespace-nowrap"><%= money(sum.total - sum.paid) %></td><td></td></tr></tfoot>
  </table></div>
  <% } %>
</div>

<%- include('_footer') %>
