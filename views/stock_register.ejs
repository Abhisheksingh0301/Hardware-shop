<%- include('_header') %>

<%
  // Where each kind of movement links to
  function refLink(m) {
    if (!m.ref_id) return '';
    if (m.kind === 'sale') return '/invoices/' + m.ref_id;
    if (m.kind === 'purchase') return '/purchases/' + m.ref_id;
    if (m.kind === 'grill') return '/grill/' + m.ref_id;
    return '';
  }
%>

<% if (product) { %>
  <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
    <div>
      <h1><%= product.name %></h1>
      <div class="text-gray-500">
        <span class="badge badge-<%= product.type %>"><%= PRODUCT_TYPES[product.type] %></span>
        <%= product.category %><% if (product.brand) { %> · <%= product.brand %><% } %><% if (product.size) { %> · <%= product.size %><% } %>
      </div>
    </div>
    <div class="flex flex-wrap gap-2">
      <a class="btn" href="/inventory/<%= product.id %>/edit">Edit</a>
      <form class="inline" method="post" action="/inventory/<%= product.id %>/delete" data-confirm="Remove this product from the lists? Its history is kept.">
        <button class="btn btn-danger">Remove</button>
      </form>
    </div>
  </div>

  <div class="mb-4 grid grid-cols-[repeat(auto-fit,minmax(170px,1fr))] gap-3">
    <div class="rounded-[10px] border border-gray-200 bg-white p-3.5"><div class="text-xs text-gray-500">In stock</div><div class="mt-0.5 text-xl font-semibold <%= product.stock <= product.min_stock ? 'text-red-700' : '' %>"><%= qty(product.stock) %> <%= product.unit %></div></div>
    <div class="rounded-[10px] border border-gray-200 bg-white p-3.5"><div class="text-xs text-gray-500">Minimum level</div><div class="mt-0.5 text-xl font-semibold"><%= qty(product.min_stock) %></div></div>
    <div class="rounded-[10px] border border-gray-200 bg-white p-3.5"><div class="text-xs text-gray-500">Purchase / Selling price</div><div class="mt-0.5 text-base font-semibold"><%= money(product.purchase_price) %> / <%= money(product.selling_price) %></div></div>
    <div class="rounded-[10px] border border-gray-200 bg-white p-3.5"><div class="text-xs text-gray-500">GST · Supplier</div><div class="mt-0.5 text-base font-semibold"><%= product.gst_rate %>% · <%= product.supplier || '-' %></div></div>
  </div>

  <form class="card" method="post" action="/inventory/<%= product.id %>/adjust">
    <h2>Stock adjustment</h2>
    <div class="mb-3 flex flex-wrap items-end gap-2 *:w-auto [&_input]:min-w-[140px] [&_select]:min-w-[140px]">
      <div><label>Quantity (+ add / − remove)</label><input type="number" step="any" name="qty" required></div>
      <div class="flex-1"><label>Reason</label><input name="note" placeholder="e.g. damaged, physical count correction"></div>
      <button class="btn btn-primary">Save</button>
    </div>
  </form>
<% } else { %>
  <div class="mb-4 flex flex-wrap items-center justify-between gap-3"><h1>Inventory Register</h1></div>
  <form class="card mb-3 flex flex-wrap items-end gap-2 *:w-auto [&_input]:min-w-[140px] [&_select]:min-w-[140px]" method="get">
    <div><label>From</label><input type="date" name="from" value="<%= from %>"></div>
    <div><label>To</label><input type="date" name="to" value="<%= to %>"></div>
    <div>
      <label>Type</label>
      <select name="type">
        <option value="">All</option>
        <% Object.keys(PRODUCT_TYPES).forEach(function (t) { %><option value="<%= t %>" <%= type === t ? 'selected' : '' %>><%= PRODUCT_TYPES[t] %></option><% }) %>
      </select>
    </div>
    <button class="btn">Show</button>
  </form>
<% } %>

<div class="card">
  <h2>Stock movements</h2>
  <% if (!rows.length) { %><p class="text-gray-500">No stock movements.</p><% } else { %>
  <div class="overflow-x-auto"><table>
    <tr><th>Date / time</th><% if (!product) { %><th>Product</th><% } %><th>Type</th><th>Details</th><th class="text-right whitespace-nowrap">In</th><th class="text-right whitespace-nowrap">Out</th></tr>
    <% rows.forEach(function (m) { var link = refLink(m); %>
      <tr>
        <td class="whitespace-nowrap"><%= m.created_at %></td>
        <% if (!product) { %><td><a href="/inventory/<%= m.product_id %>"><%= m.name %></a></td><% } %>
        <td><span class="badge"><%= m.kind %></span></td>
        <td><% if (link) { %><a href="<%= link %>"><%= m.note %></a><% } else { %><%= m.note %><% } %></td>
        <td class="text-right whitespace-nowrap text-green-700"><%= m.qty > 0 ? qty(m.qty) + ' ' + m.unit : '' %></td>
        <td class="text-right whitespace-nowrap text-red-700"><%= m.qty < 0 ? qty(-m.qty) + ' ' + m.unit : '' %></td>
      </tr>
    <% }) %>
  </table></div>
  <% } %>
</div>

<%- include('_footer') %>
