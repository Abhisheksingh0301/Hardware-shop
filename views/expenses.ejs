<%- include('_header') %>

<div class="mb-4 flex flex-wrap items-center justify-between gap-3"><h1>Expenses</h1></div>

<form class="card" method="post" action="/accounts/expenses">
  <h2>Add expense</h2>
  <div class="grid grid-cols-[repeat(auto-fit,minmax(200px,1fr))] gap-x-4 gap-y-3">
    <div><label>Date</label><input type="date" name="exp_date" value="<%= today() %>"></div>
    <div>
      <label>Category</label>
      <input name="category" list="exp-cats" required placeholder="Pick or type">
      <datalist id="exp-cats"><% EXPENSE_CATEGORIES.forEach(function (c) { %><option value="<%= c %>"><% }) %></datalist>
    </div>
    <div><label>Amount (₹)</label><input type="number" step="0.01" min="0.01" name="amount" required></div>
    <div><label>Mode</label><select name="mode"><% PAY_MODES.forEach(function (m) { %><option><%= m %></option><% }) %></select></div>
    <div class="col-span-full"><label>Note</label><input name="note"></div>
  </div>
  <p><button class="btn btn-primary">Save expense</button></p>
</form>

<div class="card">
  <form class="mb-3 flex flex-wrap items-end gap-2 *:w-auto [&_input]:min-w-[140px] [&_select]:min-w-[140px]" method="get">
    <div><label>From</label><input type="date" name="from" value="<%= from %>"></div>
    <div><label>To</label><input type="date" name="to" value="<%= to %>"></div>
    <button class="btn">Show</button>
  </form>
  <% if (!rows.length) { %><p class="text-gray-500">No expenses in this period.</p><% } else { %>
  <div class="overflow-x-auto"><table>
    <tr><th>Date</th><th>Category</th><th>Note</th><th>Mode</th><th class="text-right whitespace-nowrap">Amount</th><th></th></tr>
    <% rows.forEach(function (e) { %>
      <tr>
        <td><%= e.exp_date %></td><td><%= e.category %></td><td><%= e.note %></td><td><%= e.mode %></td>
        <td class="text-right whitespace-nowrap"><%= money(e.amount) %></td>
        <td><form class="inline" method="post" action="/accounts/expenses/<%= e.id %>/delete" data-confirm="Delete this expense?"><button class="btn btn-sm btn-danger">✕</button></form></td>
      </tr>
    <% }) %>
    <tfoot><tr><td colspan="4">Total</td><td class="text-right whitespace-nowrap"><%= money(total) %></td><td></td></tr></tfoot>
  </table></div>
  <% } %>
</div>

<%- include('_footer') %>
