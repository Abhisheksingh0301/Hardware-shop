<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | <%= shop.name %></title>
  <link rel="icon" type="image/svg+xml" href="/images/favicon.svg">
  <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body>
<div class="flex min-h-screen max-[800px]:flex-col print:block">
  <aside class="w-53.75 shrink-0 bg-slate-800 text-slate-300 max-[800px]:w-full print:hidden">
    <div class="border-b border-slate-700 px-4.5 pt-4.5 pb-3.5">
      <strong class="block text-[17px] text-white"><%= shop.name %></strong>
      <small class="text-slate-400"><%= shop.tagline %></small>
    </div>
    <%
      var menu = [
        ['', [['/', 'Dashboard']]],
        ['Shop Sales', [['/invoices/new', 'New Sale'], ['/invoices', 'Sales Invoices'], ['/purchases', 'Purchases']]],
        ['Inventory', [['/inventory?type=paint', 'Paint'], ['/inventory?type=hardware', 'Hardware'],
                       ['/inventory?type=raw', 'Raw Material'], ['/inventory/register', 'Inventory Register'], ['/brands', 'Paint Brands']]],
        ['Grill Manufacturing', [['/grill/new', 'New Grill Order'], ['/grill', 'Grill Jobs']]],
        ['Accounts', [['/accounts/payments', 'Payments'], ['/accounts/expenses', 'Expenses'],
                      ['/accounts/daybook', 'Cash / UPI Register'], ['/accounts/reports', 'Reports']]],
        ['Masters', [['/customers', 'Customers'], ['/suppliers', 'Suppliers']]]
      ];
    %>
    <nav class="px-2.5 pt-2 pb-5 max-[800px]:flex max-[800px]:flex-wrap max-[800px]:gap-0.5">
      <% menu.forEach(function (group) { %>
        <% if (group[0]) { %><div class="mx-2 mt-3.5 mb-1 text-[11px] tracking-[.06em] text-slate-500 uppercase max-[800px]:mt-2 max-[800px]:mb-0.5 max-[800px]:w-full"><%= group[0] %></div><% } %>
        <% group[1].forEach(function (item) {
             var parts = item[0].split('?type=');
             var base = parts[0], active;
             if (parts[1]) active = path === base && query.type === parts[1];
             else if (base === '/') active = path === '/';
             else active = path === base || (path.indexOf(base + '/') === 0 && path !== '/invoices/new' && path !== '/grill/new');
        %>
          <a href="<%= item[0] %>" class="block rounded-md px-2.5 py-1.5 text-slate-300 hover:bg-slate-700 hover:text-white hover:no-underline aria-[current=page]:bg-orange-700 aria-[current=page]:text-white"<%- active ? ' aria-current="page"' : '' %>><%= item[1] %></a>
        <% }) %>
      <% }) %>
    </nav>
  </aside>

  <main class="min-w-0 flex-1 px-6.5 py-5.5 max-[800px]:p-4 print:p-0">
    <% if (msg) { %><div class="alert alert-ok print:hidden"><%= msg %></div><% } %>
    <% if (err) { %><div class="alert alert-bad print:hidden"><%= err %></div><% } %>
