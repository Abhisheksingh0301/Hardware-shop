<%- include('_header') %>

<div class="mb-4 flex flex-wrap items-center justify-between gap-3">
  <h1>Dashboard</h1>
  <div class="flex flex-wrap gap-2">
    <a class="btn btn-primary" href="/invoices/new">+ New Sale</a>
    <a class="btn" href="/purchases/new">+ Purchase</a>
    <a class="btn" href="/grill/new">+ Grill Order</a>
  </div>
</div>

<div class="mb-4 grid grid-cols-[repeat(auto-fit,minmax(170px,1fr))] gap-3">
  <div class="rounded-[10px] border border-gray-200 bg-white p-3.5"><div class="text-xs text-gray-500">Today's sales</div><div class="mt-0.5 text-xl font-semibold"><%= money(sales.today) %></div></div>
  <div class="rounded-[10px] border border-gray-200 bg-white p-3.5"><div class="text-xs text-gray-500">Collected today</div><div class="mt-0.5 text-xl font-semibold"><%= money(collected.today) %></div></div>
  <div class="rounded-[10px] border border-gray-200 bg-white p-3.5"><div class="text-xs text-gray-500">Sales this month</div><div class="mt-0.5 text-xl font-semibold"><%= money(sales.month) %></div></div>
  <div class="rounded-[10px] border border-gray-200 bg-white p-3.5"><div class="text-xs text-gray-500">Customers owe us</div><div class="mt-0.5 text-xl font-semibold"><a href="/accounts/reports#receivables"><%= money(receivable) %></a></div></div>
  <div class="rounded-[10px] border border-gray-200 bg-white p-3.5"><div class="text-xs text-gray-500">We owe suppliers</div><div class="mt-0.5 text-xl font-semibold"><a href="/accounts/reports#payables"><%= money(payable) %></a></div></div>
</div>

<div class="grid grid-cols-[repeat(auto-fit,minmax(340px,1fr))] gap-4 ">
  <div class="card">
    <h2>Active grill jobs</h2>
    <% if (!jobs.length) { %><p class="text-gray-500">No open grill jobs.</p><% } else { %>
    <div class="overflow-x-auto"><table>
      <tr><th>Job</th><th>Customer</th><th>Type</th><th>Status</th><th>Due</th></tr>
      <% jobs.forEach(function (j) { %>
        <tr>
          <td><a href="/grill/<%= j.id %>"><%= j.job_no %></a></td>
          <td><%= j.customer %></td>
          <td><%= j.grill_type %></td>
          <td><span class="badge badge-warn"><%= j.status %></span></td>
          <td class="whitespace-nowrap <%= j.expected_date && j.expected_date < today() ? 'text-red-700' : '' %>"><%= j.expected_date || '-' %></td>
        </tr>
      <% }) %>
    </table></div>
    <% } %>
  </div>

  <div class="card">
    <h2>Low stock <a class="btn btn-sm float-right" href="/inventory?low=1">View all</a></h2>
    <% if (!lowStock.length) { %><p class="text-gray-500">All items are above their minimum level.</p><% } else { %>
    <div class="overflow-x-auto"><table>
      <tr><th>Item</th><th>Type</th><th class="text-right whitespace-nowrap">Stock</th><th class="text-right whitespace-nowrap">Min</th></tr>
      <% lowStock.forEach(function (p) { %>
        <tr>
          <td><a href="/inventory/<%= p.id %>"><%= p.name %></a></td>
          <td><span class="badge badge-<%= p.type %>"><%= p.type %></span></td>
          <td class="text-right whitespace-nowrap text-red-700"><%= qty(p.stock) %> <%= p.unit %></td>
          <td class="text-right whitespace-nowrap"><%= qty(p.min_stock) %></td>
        </tr>
      <% }) %>
    </table></div>
    <% } %>
  </div>
</div>

<div class="card">
  <h2>Recent sales</h2>
  <% if (!invoices.length) { %><p class="text-gray-500">No sales yet. <a href="/invoices/new">Make the first sale</a>.</p><% } else { %>
  <div class="overflow-x-auto"><table>
    <tr><th>Invoice</th><th>Date</th><th>Customer</th><th class="text-right whitespace-nowrap">Total</th></tr>
    <% invoices.forEach(function (i) { %>
      <tr>
        <td><a href="/invoices/<%= i.id %>"><%= i.invoice_no %></a></td>
        <td><%= i.invoice_date %></td>
        <td><%= i.customer %></td>
        <td class="text-right whitespace-nowrap"><%= money(i.total) %></td>
      </tr>
    <% }) %>
  </table></div>
  <% } %>
</div>

<%- include('_footer') %>
