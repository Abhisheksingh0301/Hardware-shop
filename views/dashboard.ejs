<%- include('_header') %>

<div class="page-head">
  <h1>Dashboard</h1>
  <div class="actions">
    <a class="btn primary" href="/invoices/new">+ New Sale</a>
    <a class="btn" href="/purchases/new">+ Purchase</a>
    <a class="btn" href="/grill/new">+ Grill Order</a>
  </div>
</div>

<div class="stats">
  <div class="stat"><div class="label">Today's sales</div><div class="value"><%= money(sales.today) %></div></div>
  <div class="stat"><div class="label">Collected today</div><div class="value"><%= money(collected.today) %></div></div>
  <div class="stat"><div class="label">Sales this month</div><div class="value"><%= money(sales.month) %></div></div>
  <div class="stat"><div class="label">Customers owe us</div><div class="value"><a href="/accounts/reports#receivables"><%= money(receivable) %></a></div></div>
  <div class="stat"><div class="label">We owe suppliers</div><div class="value"><a href="/accounts/reports#payables"><%= money(payable) %></a></div></div>
</div>

<div class="grid two">
  <div class="card">
    <h2>Active grill jobs</h2>
    <% if (!jobs.length) { %><p class="muted">No open grill jobs.</p><% } else { %>
    <div class="table-wrap"><table>
      <tr><th>Job</th><th>Customer</th><th>Type</th><th>Status</th><th>Due</th></tr>
      <% jobs.forEach(function (j) { %>
        <tr>
          <td><a href="/grill/<%= j.id %>"><%= j.job_no %></a></td>
          <td><%= j.customer %></td>
          <td><%= j.grill_type %></td>
          <td><span class="badge warn"><%= j.status %></span></td>
          <td class="nowrap <%= j.expected_date && j.expected_date < today() ? 'neg' : '' %>"><%= j.expected_date || '-' %></td>
        </tr>
      <% }) %>
    </table></div>
    <% } %>
  </div>

  <div class="card">
    <h2>Low stock <a class="btn small" href="/inventory?low=1" style="float:right">View all</a></h2>
    <% if (!lowStock.length) { %><p class="muted">All items are above their minimum level.</p><% } else { %>
    <div class="table-wrap"><table>
      <tr><th>Item</th><th>Type</th><th class="num">Stock</th><th class="num">Min</th></tr>
      <% lowStock.forEach(function (p) { %>
        <tr>
          <td><a href="/inventory/<%= p.id %>"><%= p.name %></a></td>
          <td><span class="badge <%= p.type %>"><%= p.type %></span></td>
          <td class="num neg"><%= qty(p.stock) %> <%= p.unit %></td>
          <td class="num"><%= qty(p.min_stock) %></td>
        </tr>
      <% }) %>
    </table></div>
    <% } %>
  </div>
</div>

<div class="card">
  <h2>Recent sales</h2>
  <% if (!invoices.length) { %><p class="muted">No sales yet. <a href="/invoices/new">Make the first sale</a>.</p><% } else { %>
  <div class="table-wrap"><table>
    <tr><th>Invoice</th><th>Date</th><th>Customer</th><th class="num">Total</th></tr>
    <% invoices.forEach(function (i) { %>
      <tr>
        <td><a href="/invoices/<%= i.id %>"><%= i.invoice_no %></a></td>
        <td><%= i.invoice_date %></td>
        <td><%= i.customer %></td>
        <td class="num"><%= money(i.total) %></td>
      </tr>
    <% }) %>
  </table></div>
  <% } %>
</div>

<%- include('_footer') %>
