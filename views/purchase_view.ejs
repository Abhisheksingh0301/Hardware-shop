<%- include('_header') %>

<% var balance = pu.total - pu.paid; %>

<div class="mb-4 flex flex-wrap items-center justify-between gap-3 print:hidden">
  <h1>Purchase <%= pu.invoice_no || '#' + pu.id %></h1>
  <div class="flex flex-wrap gap-2">
    <button class="btn" onclick="window.print()">Print</button>
    <form class="inline" method="post" action="/purchases/<%= pu.id %>/delete" data-confirm="Delete this purchase? Its stock will be removed and payments deleted.">
      <button class="btn btn-danger">Delete / return</button>
    </form>
  </div>
</div>

<div class="card max-w-[820px]">
  <div class="mb-3 flex justify-between gap-4 border-b-2 border-gray-800 pb-2.5 [&_h1]:text-xl">
    <div>
      <h1>Goods Receipt / Purchase</h1>
      <div>Supplier: <a href="/suppliers/<%= pu.supplier_id %>"><strong><%= pu.supplier %></strong></a><% if (pu.phone) { %> · <%= pu.phone %><% } %></div>
      <% if (pu.gstin) { %><div class="text-gray-500">GSTIN: <%= pu.gstin %></div><% } %>
    </div>
    <div class="text-right">
      <div>Bill no. <strong><%= pu.invoice_no || '-' %></strong></div>
      <div>Date: <%= pu.purchase_date %></div>
    </div>
  </div>

  <div class="overflow-x-auto"><table>
    <tr><th>#</th><th>Item</th><th class="text-right whitespace-nowrap">Qty</th><th class="text-right whitespace-nowrap">Rate</th><th class="text-right whitespace-nowrap">GST</th><th class="text-right whitespace-nowrap">Amount</th></tr>
    <% items.forEach(function (it, i) { %>
      <tr>
        <td><%= i + 1 %></td>
        <td><a href="/inventory/<%= it.product_id %>"><%= it.name %></a> <span class="badge badge-<%= it.type %>"><%= it.type %></span></td>
        <td class="text-right whitespace-nowrap"><%= qty(it.qty) %> <%= it.unit %></td>
        <td class="text-right whitespace-nowrap"><%= money(it.rate) %></td>
        <td class="text-right whitespace-nowrap"><%= it.gst_rate %>%</td>
        <td class="text-right whitespace-nowrap"><%= money(it.amount) %></td>
      </tr>
    <% }) %>
  </table></div>

  <table class="ml-auto max-w-[340px] [&_td]:border-0 [&_td]:px-2 [&_td]:py-0.75">
    <tr><td>Subtotal</td><td class="text-right whitespace-nowrap"><%= money(pu.subtotal) %></td></tr>
    <tr><td>GST</td><td class="text-right whitespace-nowrap"><%= money(pu.tax) %></td></tr>
    <tr class="text-[17px] font-bold *:border-t!"><td>Total</td><td class="text-right whitespace-nowrap"><%= money(pu.total) %></td></tr>
    <tr><td>Paid</td><td class="text-right whitespace-nowrap"><%= money(pu.paid) %></td></tr>
    <tr><td><strong>Balance</strong></td><td class="text-right whitespace-nowrap <%= balance > 0.009 ? 'text-red-700' : '' %>"><strong><%= money(balance) %></strong></td></tr>
  </table>
  <% if (pu.notes) { %><p class="text-gray-500">Note: <%= pu.notes %></p><% } %>
</div>

<div class="card print:hidden">
  <h2>Payments to supplier</h2>
  <% if (!payments.length) { %><p class="text-gray-500">Nothing paid yet.</p><% } else { %>
  <table>
    <tr><th>Date</th><th>Mode</th><th>Reference</th><th class="text-right whitespace-nowrap">Amount</th><th></th></tr>
    <% payments.forEach(function (p) { %>
      <tr>
        <td><%= p.pay_date %></td><td><%= p.mode %></td><td><%= p.reference %></td>
        <td class="text-right whitespace-nowrap"><%= money(p.amount) %></td>
        <td class="whitespace-nowrap">
          <a class="btn btn-sm" href="/accounts/payments/<%= p.id %>">Voucher</a>
          <form class="inline" method="post" action="/accounts/payments/<%= p.id %>/delete" data-confirm="Delete this payment?">
            <input type="hidden" name="back" value="/purchases/<%= pu.id %>"><button class="btn btn-sm btn-danger">Delete</button>
          </form>
        </td>
      </tr>
    <% }) %>
  </table>
  <% } %>

  <% if (balance > 0.009) { %>
    <form method="post" action="/accounts/payments" class="mt-3 flex flex-wrap items-end gap-2 *:w-auto [&_input]:min-w-[140px] [&_select]:min-w-[140px]">
      <input type="hidden" name="purchase_id" value="<%= pu.id %>">
      <input type="hidden" name="back" value="/purchases/<%= pu.id %>">
      <div><label>Amount</label><input type="number" step="0.01" min="0.01" name="amount" value="<%= balance.toFixed(2) %>"></div>
      <div><label>Mode</label><select name="mode"><% PAY_MODES.forEach(function (m) { %><option><%= m %></option><% }) %></select></div>
      <div><label>Date</label><input type="date" name="pay_date" value="<%= today() %>"></div>
      <div><label>Reference</label><input name="reference"></div>
      <button class="btn btn-primary">Pay supplier</button>
    </form>
  <% } %>
</div>

<%- include('_footer') %>
