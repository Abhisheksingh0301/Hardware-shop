<%- include('_header') %>

<% var balance = pu.total - pu.paid; %>

<div class="page-head no-print">
  <h1>Purchase <%= pu.invoice_no || '#' + pu.id %></h1>
  <div class="actions">
    <button class="btn" onclick="window.print()">Print</button>
    <form class="inline" method="post" action="/purchases/<%= pu.id %>/delete" data-confirm="Delete this purchase? Its stock will be removed and payments deleted.">
      <button class="btn danger">Delete / return</button>
    </form>
  </div>
</div>

<div class="card doc">
  <div class="doc-head">
    <div>
      <h1>Goods Receipt / Purchase</h1>
      <div>Supplier: <a href="/suppliers/<%= pu.supplier_id %>"><strong><%= pu.supplier %></strong></a><% if (pu.phone) { %> · <%= pu.phone %><% } %></div>
      <% if (pu.gstin) { %><div class="muted">GSTIN: <%= pu.gstin %></div><% } %>
    </div>
    <div class="right">
      <div>Bill no. <strong><%= pu.invoice_no || '-' %></strong></div>
      <div>Date: <%= pu.purchase_date %></div>
    </div>
  </div>

  <div class="table-wrap"><table>
    <tr><th>#</th><th>Item</th><th class="num">Qty</th><th class="num">Rate</th><th class="num">GST</th><th class="num">Amount</th></tr>
    <% items.forEach(function (it, i) { %>
      <tr>
        <td><%= i + 1 %></td>
        <td><a href="/inventory/<%= it.product_id %>"><%= it.name %></a> <span class="badge <%= it.type %>"><%= it.type %></span></td>
        <td class="num"><%= qty(it.qty) %> <%= it.unit %></td>
        <td class="num"><%= money(it.rate) %></td>
        <td class="num"><%= it.gst_rate %>%</td>
        <td class="num"><%= money(it.amount) %></td>
      </tr>
    <% }) %>
  </table></div>

  <table class="totals">
    <tr><td>Subtotal</td><td class="num"><%= money(pu.subtotal) %></td></tr>
    <tr><td>GST</td><td class="num"><%= money(pu.tax) %></td></tr>
    <tr class="grand"><td>Total</td><td class="num"><%= money(pu.total) %></td></tr>
    <tr><td>Paid</td><td class="num"><%= money(pu.paid) %></td></tr>
    <tr><td><strong>Balance</strong></td><td class="num <%= balance > 0.009 ? 'neg' : '' %>"><strong><%= money(balance) %></strong></td></tr>
  </table>
  <% if (pu.notes) { %><p class="muted">Note: <%= pu.notes %></p><% } %>
</div>

<div class="card no-print">
  <h2>Payments to supplier</h2>
  <% if (!payments.length) { %><p class="muted">Nothing paid yet.</p><% } else { %>
  <table>
    <tr><th>Date</th><th>Mode</th><th>Reference</th><th class="num">Amount</th><th></th></tr>
    <% payments.forEach(function (p) { %>
      <tr>
        <td><%= p.pay_date %></td><td><%= p.mode %></td><td><%= p.reference %></td>
        <td class="num"><%= money(p.amount) %></td>
        <td class="nowrap">
          <a class="btn small" href="/accounts/payments/<%= p.id %>">Voucher</a>
          <form class="inline" method="post" action="/accounts/payments/<%= p.id %>/delete" data-confirm="Delete this payment?">
            <input type="hidden" name="back" value="/purchases/<%= pu.id %>"><button class="btn small danger">Delete</button>
          </form>
        </td>
      </tr>
    <% }) %>
  </table>
  <% } %>

  <% if (balance > 0.009) { %>
    <form method="post" action="/accounts/payments" class="filters" style="margin-top:12px">
      <input type="hidden" name="purchase_id" value="<%= pu.id %>">
      <input type="hidden" name="back" value="/purchases/<%= pu.id %>">
      <div><label>Amount</label><input type="number" step="0.01" min="0.01" name="amount" value="<%= balance.toFixed(2) %>"></div>
      <div><label>Mode</label><select name="mode"><% PAY_MODES.forEach(function (m) { %><option><%= m %></option><% }) %></select></div>
      <div><label>Date</label><input type="date" name="pay_date" value="<%= today() %>"></div>
      <div><label>Reference</label><input name="reference"></div>
      <button class="btn primary">Pay supplier</button>
    </form>
  <% } %>
</div>

<%- include('_footer') %>
