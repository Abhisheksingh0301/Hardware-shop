{
  "name": "hw-shop",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -i ./src/app.css -o ./public/stylesheets/style.css --minify",
    "watch:css": "tailwindcss -i ./src/app.css -o ./public/stylesheets/style.css --watch",
    "prestart": "npm run build:css",
    "start": "node ./bin/www"
  },
  "dependencies": {
    "cookie-parser": "~1.4.4",
    "debug": "~2.6.9",
    "dotenv": "^18.0.4",
    "ejs": "^3.1.10",
    "express": "~4.16.1",
    "http-errors": "~1.6.3",
    "morgan": "~1.9.1",
    "qrcode": "^1.5.4",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  }
}
