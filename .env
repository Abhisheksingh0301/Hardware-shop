# ---------------------------------------------------------------------------
# Hardware Shop settings. Restart the app (npm start) after changing this file.
# ---------------------------------------------------------------------------

# Server
PORT=3020

# Shop details - printed on invoices, job cards and receipts
SHOP_NAME=Hardware Shop
SHOP_TAGLINE=Paint · Hardware · Grill Fabrication
SHOP_ADDRESS=Main Road, Your City - 000000
SHOP_PHONE=+91 90000 00000
SHOP_EMAIL=shop@example.com
SHOP_GSTIN=

# Payments - shown on invoices so customers can pay
SHOP_UPI_ID=yourshop@upi
SHOP_UPI_NAME=Hardware Shop
BANK_NAME=
BANK_ACCOUNT_NO=
BANK_IFSC=

# Footer line at the bottom of every invoice
INVOICE_FOOTER=Thank you, visit again!

# Database file (optional - defaults to hwshop.db in the project folder)
# DB_FILE=C:/path/to/hwshop.db
